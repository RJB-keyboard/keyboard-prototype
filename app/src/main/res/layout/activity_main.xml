<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity applies system bar and IME padding to this container at runtime.
     Keep the ScrollView inside it so its viewport excludes the keyboard area. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame,UselessParent">

    <ScrollView
        android:id="@id/setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_instructions"
            android:textSize="16sp" />

        <Button
            android:id="@+id/enable_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/enable_keyboard" />

        <Button
            android:id="@+id/choose_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_keyboard" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/test_input_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/test_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/test_input_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minHeight="120dp"
            android:maxLines="4"
            android:scrollbars="vertical"
            android:saveEnabled="false"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prototype_note"
            android:textSize="14sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
