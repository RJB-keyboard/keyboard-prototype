<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/candidate_panel_height"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <FrameLayout
                    android:id="@+id/compact_candidates"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="58dp">
                    <TextView
                        android:id="@+id/candidate_hint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/candidate_hint"
                        android:textColor="#42516A"
                        android:textSize="14sp" />
                    <HorizontalScrollView
                        android:id="@+id/candidate_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none"
                        android:fillViewport="true"
                        android:visibility="gone">
                        <net.ramdos.keyboard_prototype.ui.CandidateRowsView
                            android:id="@+id/candidate_row"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layoutDirection="ltr" />
                    </HorizontalScrollView>
                </FrameLayout>
                <Button
                    android:id="@+id/expand_candidates_key"
                    android:layout_width="48dp"
                    android:layout_height="@dimen/candidate_row_height"
                    android:layout_gravity="top|end"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/expand_candidates_key"
                    android:contentDescription="@string/expand_candidates"
                    android:backgroundTint="#DDE1E6"
                    android:textColor="#17212E"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/backspace_key"
                    android:layout_width="56dp"
                    android:layout_height="@dimen/candidate_row_height"
                    android:layout_gravity="bottom|end"
                    android:minWidth="0dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:backgroundTint="#DDE1E6"
                    android:contentDescription="@string/backspace_description"
                    android:text="@string/backspace_key"
                    android:textAllCaps="false"
                    android:textColor="#17212E"
                    android:textSize="24sp" />
            </FrameLayout>
            <net.ramdos.keyboard_prototype.ui.GojuonBoardView
                android:id="@+id/gojuon_board"
                android:layout_width="match_parent"
                android:layout_height="@dimen/gojuon_board_height"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/expanded_candidates_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="108dp"
            android:gravity="center"
            android:text="@string/expanded_candidates_title"
            android:textColor="#42516A"
            android:visibility="gone" />
        <ScrollView
            android:id="@+id/expanded_candidates_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="64dp"
            android:layout_marginBottom="4dp"
            android:scrollbars="vertical"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/expanded_candidates_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <!-- These are keyboard keys, not dialog actions: keep their bounded backgrounds. -->
    <LinearLayout
        android:id="@+id/action_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        tools:ignore="ButtonStyle">
        <Button
            android:id="@+id/cursor_left_key"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:backgroundTint="#DDE1E6"
            android:contentDescription="@string/cursor_left_description"
            android:text="@string/cursor_left_key"
            android:textAllCaps="false"
            android:textColor="#17212E"
            android:textSize="28sp" />
        <Button
            android:id="@+id/punctuation_key"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:backgroundTint="#DDE1E6"
            android:contentDescription="@string/punctuation_description"
            android:text="@string/punctuation_key"
            android:textAllCaps="false"
            android:textColor="#17212E"
            android:textSize="20sp" />
        <net.ramdos.keyboard_prototype.ui.RaisedSymbolButton
            android:id="@+id/space_key"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:minWidth="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:backgroundTint="#DDE1E6"
            android:contentDescription="@string/space_description"
            android:text="@string/space_key"
            android:textAllCaps="false"
            android:textColor="#17212E"
            android:textSize="36sp" />
        <net.ramdos.keyboard_prototype.ui.RaisedSymbolButton
            android:id="@+id/enter_key"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:minWidth="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:backgroundTint="#DDE1E6"
            android:contentDescription="@string/enter_newline"
            android:text="@string/enter_newline_symbol"
            android:textScaleX="1.6"
            android:textAllCaps="false"
            android:textColor="#17212E"
            android:textSize="36sp" />
        <Button
            android:id="@+id/cursor_right_key"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:backgroundTint="#DDE1E6"
            android:contentDescription="@string/cursor_right_description"
            android:text="@string/cursor_right_key"
            android:textAllCaps="false"
            android:textColor="#17212E"
            android:textSize="28sp" />
    </LinearLayout>
</merge>
